# Template for hosts/<name>/.env  (copy to hosts/vm/.env and fill in)
HOST_DIR=./hosts/vm
VM_IP=<public ip>             # client zips point here (./duds.sh package); never commit the real one
TAG=latest                    # or a git commit to pin/roll back
PRERE_DB_PASS=change-me       # openssl rand -hex 16
RE_DB_PASS=change-me
PRERE_DB_VOLUME=duds_prere_db
RE_DB_VOLUME=duds_re_db
HTTP_PORT=80
HTTPS_PORT=443
SITE_ADDRESS=:80              # or your domain → automatic HTTPS
DL_USER=friends
DL_TOKEN=                     # set with: ./duds.sh set-password vm <user>

# ---- portal: account requests, website login, password reset (build/portal) ----
PORTAL_URL=https://ragnaduds.duckdns.org   # links in the e-mails
ADMIN_EMAIL=                              # gets the daily "requests waiting" e-mail
SMTP_HOST=                                # e.g. smtp.gmail.com (with an app password) (empty: e-mails only kept in the admin outbox)
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=                                # e.g. "RagnaDuds <ragnaduds@gmail.com>" WITH the quotes (duds.sh reads this file with bash)
