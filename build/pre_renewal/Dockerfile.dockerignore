# Used automatically for "Dockerfile" in this folder (build context = repo root).
# Only the rAthena source and our patches go in; local build output and secrets stay out.
*
!rathena
!patches
rathena/.git
rathena/tools/docker
rathena/**/obj
rathena/**/Makefile
rathena/config.log
rathena/config.status
rathena/login-server
rathena/char-server
rathena/map-server
rathena/web-server
rathena/conf/import
rathena/conf/msg_conf/import
rathena/db/import
